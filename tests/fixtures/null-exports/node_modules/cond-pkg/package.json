{
  "name": "cond-pkg",
  "exports": {
    ".": {
      "node": "./index.js",
      "default": "./index.js"
    },
    "./browser": {
      "types": "./browser.d.ts",
      "node": null,
      "default": "./browser.js"
    },
    "./features/*": {
      "node": null,
      "default": "./features/*.js"
    },
    "./node-only": {
      "node": "./node-only.js"
    },
    "./nested": {
      "import": {
        "node": null,
        "default": "./nested.js"
      },
      "default": "./nested.js"
    }
  }
}
